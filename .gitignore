# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Package manager lockfiles (use yarn.lock only)
package-lock.json
.npmrc

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Mobile development
android-sdk/

# ─── Secrets & credentials (NEVER commit) ─────────────────────────────
# Env files at any depth (backend/.env, frontend/.env, api/.env, …)
.env
.env.*
*.env
**/.env
**/.env.*
# Supabase local secrets / CLI state
supabase/.temp/
supabase/.branches/
**/supabase/.temp/
**/supabase/.branches/
supabase/functions/.env
**/supabase/functions/.env
# Vercel local env pulls
.vercel
.env*.local
# Keys, certs & credential dumps
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
credentials.json
*credentials*.json
*token.json*
service-account*.json
*-service-account.json
.credentials
secrets.json
*.secret
*.secrets
# Secret-scan reports (contain raw findings)
gitleaks-report*.json

# Allow safe-to-commit env templates (must stay LAST so they win)
!.env.example
!**/.env.example
!.env.production
!frontend/.env.production
